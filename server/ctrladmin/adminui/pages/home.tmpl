{{ component "layout" . }}
{{ component "layout_user" . }}

{{ component "block" (props .
    "Icon" "chart-pie"
    "Name" "stats"
    "Desc" "total items found in all watched folders"
) }}
    <div class="grid grid-cols-[auto_min-content] gap-2 gap-x-5 text-right">
        <div class="text-gray-500">folders</div>
        <div class="font-bold">{{ .Stats.Folders }}</div>
        <div class="text-gray-500">albums</div>
        <div class="font-bold">{{ .Stats.Albums }}</div>
        <div class="text-gray-500">artists</div>
        <div class="font-bold">{{ .Stats.Artists }}</div>
        <div class="text-gray-500">album artists</div>
        <div class="font-bold">{{ .Stats.AlbumArtists }}</div>
        <div class="text-gray-500">tracks</div>
        <div class="font-bold">{{ .Stats.Tracks }}</div>
        <div class="text-gray-500">internet radio stations</div>
        <div class="font-bold">{{ .Stats.InternetRadioStations }}</div>
        <div class="text-gray-500">podcasts</div>
        <div class="font-bold">{{ .Stats.Podcasts }}</div>
    </div>
{{ end }}

{{ component "block" (props .
    "Icon" "users"
    "Name" "user management"
    "Desc" "manage user accounts for subsonic api and web interface access"
) }}
<div class="grid grid-cols-[repeat(3,auto)_max-content] md:grid-cols-[auto_repeat(5,min-content)] gap-2 gap-x-5 items-center text-right">
    {{ range $user := .AllUsers }}
        <div class="col-span-3 md:col-auto ellipsis">{{ $user.Name }}</div>
        <div class="text-gray-500 whitespace-nowrap">{{ $user.CreatedAt | date }}</div>
        {{ component "link" (props . "To" (printf "/admin/change_username?user=%s" $user.Name | path)) }}username{{ end }}
        {{ component "link" (props . "To" (printf "/admin/change_password?user=%s" $user.Name | path)) }}password{{ end }}
        {{ component "link" (props . "To" (printf "/admin/change_avatar?user=%s" $user.Name | path)) }}avatar{{ end }}
        {{ if $user.IsAdmin }}
            <div class="text-gray-500">delete<span class="hidden md:inline">&#8230;</span></div>
        {{ else }}
            {{ component "link" (props . "To" (printf "/admin/delete_user?user=%s" $user.Name | path)) }}delete{{ end }}
        {{ end }}
    {{ end }}
    {{ if .User.IsAdmin }}
        <div class="col-span-full">{{ component "link" (props . "To" (path "/admin/create_user")) }}create new{{ end }}</div>
    {{ end }}
</div>
{{ end }}

{{ component "block" (props .
    "Icon" "folder-tree"
    "Name" "recent folders"
) }}
    <div class="grid grid-cols-[1fr,auto] gap-x-3 gap-y-2 items-center justify-items-end">
        {{ if eq (len .RecentFolders) 0 }}
            <div class="col-span-full text-gray-500">no folders yet</div>
        {{ end }}
        {{ range $folder := .RecentFolders }}
            <div class="text-left ellipsis">{{ $folder.RightPath }}</div>
            {{ if not $folder.CreatedAt.IsZero }}
                 <div class="text-gray-500" title="{{ $folder.CreatedAt }}">{{ $folder.CreatedAt | dateHuman }}</div>
            {{ else }}
                 <span></span>
            {{ end }}
        {{ end }}
        {{ if and (not .IsScanning) (.User.IsAdmin) }}
            {{ if not .LastScanTime.IsZero }}
                <p class="col-span-full text-gray-500" title="{{ .LastScanTime }}">scanned {{ .LastScanTime | dateHuman }}</p>
            {{ end }}
            <form class="col-span-full" action="{{ path "/admin/start_scan_inc_do" }}" method="post">
                <input type="submit" title="start a incremental scan. gonic will only scan files that have changed since the last scan. it is usually quite fast" value="scan (i)">
            </form>
            <form class="col-span-full" action="{{ path "/admin/start_scan_full_do" }}" method="post">
                <input type="submit" title="start a slow scan. gonic will not check the timestamps of changed files. you generally shouldn't need this" value="scan slow (i)">
            </form>
            <div class="col-span-full text-gray-500 pt-2">automatic scan</div>
            <form class="col-span-full grid grid-cols-[auto_auto_auto_auto] gap-2 items-center" action="{{ path "/admin/update_scan_schedule_do" }}" method="post">
                <select name="enabled" id="schedule-enabled" title="whether to scan automatically on a schedule" onchange="document.getElementById('schedule-days').disabled = document.getElementById('schedule-time').disabled = this.value !== '1';">
                    <option value="0" {{ if not .ScanSchedule.Enabled }}selected{{ end }}>off</option>
                    <option value="1" {{ if .ScanSchedule.Enabled }}selected{{ end }}>on</option>
                </select>
                <select name="days" id="schedule-days" title="interval in days between scans. the interval counts from the last completed scan"{{ if not .ScanSchedule.Enabled }} disabled{{ end }}>
                    {{ range $days := .ScanScheduleDaysOptions }}
                        <option value="{{ $days }}" {{ if eq $days $.ScanSchedule.Days }}selected{{ end }}>
                            {{ if eq $days 1 }}once a day{{ else }}every {{ $days }} days{{ end }}
                        </option>
                    {{ end }}
                </select>
                <input type="time" name="time" id="schedule-time" value="{{ printf "%02d:%02d" .ScanSchedule.Time.Hour .ScanSchedule.Time.Minute }}" title="time of day to run the scan"{{ if not .ScanSchedule.Enabled }} disabled{{ end }}>
                <input type="submit" value="save">
            </form>
            {{ if .ScanSchedule.Enabled }}
                {{ if not .LastScanTime.IsZero }}
                    <p class="col-span-full text-gray-500" title="runs every N days at the set time; manual scans never postpone it">last scan: {{ .LastScanTime | dateHuman }} · next scheduled run: {{ .NextScanRun }}</p>
                {{ else }}
                    <p class="col-span-full text-gray-500">next scheduled run: {{ .NextScanRun }}</p>
                {{ end }}
            {{ end }}
        {{ end }}
        <div id="scan-status" class="text-green-500 col-span-full" style="{{ if not .IsScanning }}display:none;{{ end }}"></div>
    </div>
    <script>
        (() => {
            const el = document.getElementById('scan-status');
            let sawScanning = {{ if .IsScanning }}true{{ else }}false{{ end }};
            const initialLastScan = {{ if not .LastScanTime.IsZero }}{{ .LastScanTime.Unix }}{{ else }}0{{ end }};
            const poll = async () => {
                try {
                    const resp = await fetch({{ path "/admin/scan_status" }}, {headers: {accept: 'application/json'}});
                    if (!resp.ok) return;
                    const status = await resp.json();
                    if (status.isScanning) {
                        sawScanning = true;
                        el.style.display = '';
                        el.textContent = `scan in progress... (${status.foldersProcessed} folders processed)`;
                        return;
                    }
                    // reload when a scan finished that we saw running, or when
                    // the last scan time changed since page load (catches
                    // scans short enough to start and finish between polls)
                    if (sawScanning || (status.lastScanTime || 0) !== initialLastScan) {
                        location.reload();
                    }
                } catch {}
            };
            poll();
            setInterval(poll, 2000);
        })();
    </script>
{{ end }}

{{ component "block" (props .
    "Icon" "music"
    "Name" "transcoding"
    "Desc" "profiles applied when streaming, via both the <span class=\"italic text-gray-800\">stream</span> endpoint and the opensubsonic <a class='text-blue-500' href='https://opensubsonic.netlify.app/docs/extensions/transcoding/' target='_blank' rel='noopener noreferrer'>transcoding extension</a>. with stream, clients adjust the bitrate via the <span class=\"italic text-gray-800\">maxBitRate</span> param. with the extension, bitrate is negotiated from the client's capabilities"
) }}
    <div class="text-left">
        <div class="text-gray-900 font-bold">override per format</div>
        <div class="font-medium text-gray-500">one per format. with stream, picked by the client's <span class="italic text-gray-800">format</span> param, topmost being the fallback when no format is specified. with the extension, picked by the negotiated format</div>
    </div>
    <div class="grid grid-cols-[1fr_auto] gap-2 items-center justify-items-end">
        {{ range $i, $fp := .TranscodeFormatPreferences }}
            <div>{{ $fp.Profile }} <span class="text-gray-500">(for {{ (index $.TranscodeProfiles $fp.Profile).Codec.Name }}{{ if eq $i 0 }}, default{{ end }})</span></div>
            <form class="contents" action="{{ printf "/admin/delete_transcode_format_pref_do?profile=%s" $fp.Profile | path }}" method="post">
            <input type="submit" value="delete">
            </form>
        {{ end }}
        {{ if not .TranscodeFormatsExhausted }}
            <form class="contents" action="{{ path "/admin/create_transcode_format_pref_do" }}" method="post">
            <select name="profile">
                {{ range $codec, $names := .TranscodeProfilesByCodec }}<optgroup label="{{ $codec }}">{{ range $name := $names }}<option value="{{ $name }}">{{ $name }}</option>{{ end }}</optgroup>{{ end }}
            </select>
            <input type="submit" value="save">
            </form>
        {{ end }}
    </div>

    <div class="text-left pt-3">
        <div class="text-gray-900 font-bold">transcode cache</div>
        {{ if .TranscodeCacheLimitMB }}
            <div class="font-medium text-gray-500">currently using <span class="italic">{{ .TranscodeCacheUsage }}</span> of a {{ .TranscodeCacheLimitMB }} MB limit</div>
        {{ else }}
            <div class="font-medium text-gray-500">currently using <span class="italic">{{ .TranscodeCacheUsage }}</span>. no size limit is configured, so the cache will grow unbounded. set <span class="italic text-gray-800">GONIC_TRANSCODE_EJECT_INTERVAL</span> to cap it automatically, or a size below</div>
        {{ end }}
        {{ if .User.IsAdmin }}
        <form class="flex gap-2 items-center pt-1" action="{{ path "/admin/update_transcode_cache_size_do" }}" method="post">
            <input type="number" name="size_mb" min="0" value="{{ .TranscodeCacheLimitMB }}" title="cache size limit in MB (0 = no limit)">
            <input type="submit" value="save">
        </form>
        {{ end }}
    </div>
    {{ if and .User.IsAdmin .TranscodeCacheLimitMB }}
    <div class="flex justify-end pt-1">
        <form class="contents" action="{{ path "/admin/eject_transcode_cache_do" }}" method="post">
            <input type="submit" value="eject now">
        </form>
    </div>
    {{ end }}

    <div class="text-left pt-3">
        <div class="text-gray-900 font-bold">override per client</div>
        <div class="font-medium text-gray-500">force a profile for a client, beating the per-format overrides. with stream, replaces the requested format. with the extension, denies direct play. seeking may not work. client names are in the gonic logs. use <span class="italic text-gray-800">*</span> as a catch-all</div>
    </div>
    <div class="grid grid-cols-[1fr_1fr_auto] gap-2 items-center justify-items-end">
        {{ range $pref := .TranscodePreferences }}
            <div class="ellipsis">{{ $pref.Client }}</div>
            <div>{{ $pref.Profile }}</div>
            <form class="contents" action="{{ printf "/admin/delete_transcode_pref_do?client=%s" $pref.Client | path }}" method="post">
            <input type="submit" value="delete">
            </form>
        {{ end }}
        <form class="contents" action="{{ path "/admin/create_transcode_pref_do" }}" method="post">
        <input type="text" name="client" placeholder="client name">
        <select name="profile">
            {{ range $codec, $names := .TranscodeProfilesByCodec }}<optgroup label="{{ $codec }}">{{ range $name := $names }}<option value="{{ $name }}">{{ $name }}</option>{{ end }}</optgroup>{{ end }}
        </select>
        <input type="submit" value="save">
        </form>
    </div>
{{ end }}

{{ component "block" (props .
    "Icon" "lastfm"
    "Name" "last.fm"
    "Desc" "scrobble to last.fm on a per user basis. adding an api key will also help gonic get rich artist info and images for subsonic clients"
) }}
    <div class="flex flex-col gap-2 items-end">
    {{ if .CurrentLastFMAPIKey }}
        {{ if .User.LastFMSession }}
            <p class="text-gray-500">current status <span class="font-bold text-green-500">linked</span></p>
            <form class="contents" action="{{ path "/admin/unlink_lastfm_do" }}" method="post">
                <input type="submit" value="unlink">
            </form>
        {{ else }}
            <p class="text-gray-500">current status <span class="font-bold text-red-400">unlinked</span></p>
            {{ $cbPath := path "/admin/link_lastfm_do" }}
            {{ $cbURL := printf "%s%s" .RequestRoot $cbPath }}
            <div>{{ component "link" (props . "To" (printf "https://www.last.fm/api/auth/?api_key=%s&cb=%s" .CurrentLastFMAPIKey $cbURL)) }}link{{ end }}</div>
        {{ end }}
    {{ else }}
        <p class="font-bold">api key not set</p>
        {{ if not .User.IsAdmin }}
            <p class="text-gray-500">please ask your admin to set it</p>
        {{ end }}
    {{ end }}
    {{ if .User.IsAdmin }}
        <p>{{ component "link" (props . "To" (path "/admin/update_lastfm_api_key" )) }}update api key{{ end }}</p>
    {{ end }}
    </div>
{{ end }}

{{ component "block" (props .
    "Icon" "brain"
    "Name" "listenbrainz"
    "Desc" "scrobble to listenbrainz and compatible sites on a per user basis"
) }}
    <div class="grid grid-cols-[1fr_1fr_auto] gap-2 items-center justify-items-end">
    {{ if .User.ListenBrainzToken }}
        <p class="text-gray-500 col-span-full">current status <span class="font-bold text-green-500">linked</span></p>
        <form class="contents" action="{{ path "/admin/unlink_listenbrainz_do" }}" method="post">
            <input class="col-span-full" type="submit" value="unlink">
        </form>
    {{ else }}
        <p class="text-gray-500 col-span-full">current status <span class="font-bold text-red-400">unlinked</span></p>
        <form class="contents" action="{{ path "/admin/link_listenbrainz_do" }}" method="post">
        <input type="text" name="url" placeholder="server addr" value="{{ default .DefaultListenBrainzURL .User.ListenBrainzURL }}">
        <input type="text" name="token" placeholder="api key" value="{{ .User.ListenBrainzToken }}">
        <input type="submit" value="update">
        </form>
    {{ end }}
    </div>
{{ end }}

{{ end }}
{{ end }}
