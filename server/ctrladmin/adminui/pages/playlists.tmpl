{{ component "layout" . }}
{{ component "layout_user" . }}

{{ component "block" (props .
    "Icon" "list"
    "Name" "playlists"
    "Desc" "playlists found in the playlists folder. smart playlist rules are read-only here; edit the m3u file to change them"
) }}
<div class="grid grid-cols-[min-content_1fr_max-content_max-content_max-content] gap-2 gap-x-5 items-center text-right">
    <div></div>
    <div class="text-left text-gray-500">name</div>
    <div class="text-gray-500">owner</div>
    <div class="text-gray-500">tracks</div>
    <div class="text-gray-500">rules</div>
    {{ if eq (len .AllPlaylists) 0 }}
        <div class="col-span-full text-gray-500 text-left">no playlists yet</div>
    {{ end }}
    {{ range $pl := .AllPlaylists }}
        <div class="text-gray-500 whitespace-nowrap" title="{{ $pl.RelPath }}">{{ if $pl.RulesJSON }}smart{{ else }}static{{ end }}</div>
        <div class="text-left ellipsis" title="{{ $pl.RelPath }}">{{ $pl.Name }}</div>
        <div class="text-gray-500 whitespace-nowrap">{{ $pl.Owner }}</div>
        <div class="text-gray-500">{{ $pl.Items }}</div>
        <div>
            {{ if $pl.RulesInvalid }}
                <span class="text-red-500" title="{{ $pl.RulesJSON }}">invalid rules</span>
            {{ else if $pl.RulesJSON }}
                <details>
                    <summary class="cursor-pointer">view</summary>
                    <pre class="text-left text-gray-500 whitespace-pre-wrap border border-gray-200 p-2 mt-1">{{ $pl.RulesJSON }}</pre>
                </details>
            {{ else }}
                <span class="text-gray-500">n/a</span>
            {{ end }}
        </div>
    {{ end }}
</div>
{{ end }}

{{ end }}
{{ end }}
